
# Stage 1: Build frontend from LOCAL patched source
FROM node:22-alpine AS frontend

RUN apk add --no-cache git
RUN npm install -g pnpm@11

WORKDIR /app
COPY . .

ENV NODE_OPTIONS=--openssl-legacy-provider

RUN pnpm install --frozen-lockfile
RUN pnpm web build:h5-netlify

# Stage 2: Build standalone Go server
FROM golang:1.26.5-alpine AS gobuilder

RUN apk add --no-cache git

WORKDIR /app

COPY --from=frontend /app/apps/web/dist /app/assets
COPY docker/latest/server/main.go /app/main.go

RUN go build -ldflags="-w -s" -o /app/md /app/main.go

# Stage 3: Runtime
FROM alpine:3.24

COPY --from=gobuilder /app/md /bin/md

EXPOSE 80

CMD ["md"]
